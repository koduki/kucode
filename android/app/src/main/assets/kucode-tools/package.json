{
  "name": "kucode-tools",
  "displayName": "KuCode Diagnostics & Tools",
  "description": "Built-in Android XR ACP AI agent chat, diagnostics, clipboard bridge, optical presets, log viewer, and storage menu for KuCode",
  "version": "0.10.1",
  "publisher": "koduki",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "コピー/貼り付け・光学テーマ・診断は未信頼ワークスペースでも利用できますが、ACP AI エージェントの実行はワークスペースの信頼後に有効化されます。"
    }
  },
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "kucode.openAcpChat",
        "title": "KuCode: AI エージェント (ACP) チャットを開く",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "kucode.sendSelectionToAcp",
        "title": "KuCode: 選択範囲を AI (ACP) チャットへ送る"
      },
      {
        "command": "kucode.setupAntigravityCli",
        "title": "KuCode: Google Antigravity CLI (agy) をインストール / ログイン"
      },
      {
        "command": "kucode.setupCopilotCli",
        "title": "KuCode: GitHub Copilot CLI (ACP) をインストール / ログイン"
      },
      {
        "command": "kucode.openMenu",
        "title": "KuCode: チェック & 管理メニューを開く",
        "icon": "$(pulse)"
      },
      {
        "command": "kucode.editorCopy",
        "title": "KuCode: コピー (エディタ)"
      },
      {
        "command": "kucode.editorCut",
        "title": "KuCode: 切り取り (エディタ)"
      },
      {
        "command": "kucode.editorPaste",
        "title": "KuCode: 貼り付け (エディタ)"
      },
      {
        "command": "kucode.terminalCopy",
        "title": "KuCode: 選択をコピー (ターミナル)"
      },
      {
        "command": "kucode.terminalPaste",
        "title": "KuCode: 貼り付け (ターミナル)"
      },
      {
        "command": "kucode.runDiagnostics",
        "title": "KuCode: 実機チェックを実行（レポートを開く & コピー）"
      },
      {
        "command": "kucode.openSessionLogs",
        "title": "KuCode: セッション診断履歴 & AI レポートを開く（現在・過去・異常終了）"
      },
      {
        "command": "kucode.openLogs",
        "title": "KuCode: 起動・エラーログを開く"
      },
      {
        "command": "kucode.toggleTerminal",
        "title": "KuCode: 統合ターミナルを開閉"
      },
      {
        "command": "kucode.selectDisplayScale",
        "title": "KuCode: 表示サイズ・ズームを変更（標準 / 大 / 特大）"
      },
      {
        "command": "kucode.selectOpticalTheme",
        "title": "KuCode: 光学テーマを切替（OST 純黒 / VST 暗灰）"
      },
      {
        "command": "kucode.openManager",
        "title": "KuCode: 管理画面を開く（ミニCLI / ストレージ許可 / 再起動）"
      },
      {
        "command": "kucode.requestStorage",
        "title": "KuCode: Android ストレージアクセスを許可"
      }
    ],
    "keybindings": [
      {
        "command": "kucode.sendSelectionToAcp",
        "key": "ctrl+shift+i",
        "when": "editorTextFocus"
      },
      {
        "command": "kucode.editorCopy",
        "key": "ctrl+c",
        "when": "editorTextFocus"
      },
      {
        "command": "kucode.editorCut",
        "key": "ctrl+x",
        "when": "editorTextFocus && !editorReadonly"
      },
      {
        "command": "kucode.editorPaste",
        "key": "ctrl+v",
        "when": "editorTextFocus && !editorReadonly"
      },
      {
        "command": "kucode.terminalPaste",
        "key": "ctrl+shift+v",
        "when": "terminalFocus"
      },
      {
        "command": "kucode.terminalPaste",
        "key": "ctrl+v",
        "when": "terminalFocus"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "kucode.openMenu",
          "group": "navigation@999"
        }
      ],
      "editor/context": [
        {
          "command": "kucode.editorCut",
          "when": "!editorReadonly",
          "group": "1_kucode_clipboard@1"
        },
        {
          "command": "kucode.editorCopy",
          "group": "1_kucode_clipboard@2"
        },
        {
          "command": "kucode.editorPaste",
          "when": "!editorReadonly",
          "group": "1_kucode_clipboard@3"
        },
        {
          "command": "kucode.sendSelectionToAcp",
          "group": "2_kucode_ai@1"
        },
        {
          "command": "kucode.runDiagnostics",
          "group": "z_kucode@1"
        },
        {
          "command": "kucode.openSessionLogs",
          "group": "z_kucode@2"
        },
        {
          "command": "kucode.openLogs",
          "group": "z_kucode@3"
        },
        {
          "command": "kucode.openManager",
          "group": "z_kucode@4"
        }
      ],
      "terminal/context": [
        {
          "command": "kucode.terminalCopy",
          "group": "1_kucode_clipboard@1"
        },
        {
          "command": "kucode.terminalPaste",
          "group": "1_kucode_clipboard@2"
        }
      ],
      "explorer/context": [
        {
          "command": "kucode.runDiagnostics",
          "group": "z_kucode@1"
        },
        {
          "command": "kucode.openSessionLogs",
          "group": "z_kucode@2"
        },
        {
          "command": "kucode.openLogs",
          "group": "z_kucode@3"
        },
        {
          "command": "kucode.openManager",
          "group": "z_kucode@4"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kucode",
          "title": "KuCode",
          "icon": "icon.svg"
        }
      ]
    },
    "views": {
      "kucode": [
        {
          "id": "kucode.acpChatView",
          "type": "webview",
          "name": "AI エージェント (ACP)"
        },
        {
          "id": "kucode.menuView",
          "name": "実機チェック & 空間表示"
        }
      ]
    },
    "configuration": {
      "title": "KuCode",
      "properties": {
        "kucode.acp.defaultAgent": {
          "type": "string",
          "scope": "application",
          "restricted": true,
          "default": "antigravity",
          "enum": [
            "antigravity",
            "copilot",
            "gemini",
            "claude",
            "codex",
            "opencode"
          ],
          "description": "既定で使用する ACP (Agent Client Protocol) 対応 AI エージェント"
        },
        "kucode.acp.permissionMode": {
          "type": "string",
          "scope": "application",
          "restricted": true,
          "default": "ask",
          "enum": [
            "ask",
            "allowAll"
          ],
          "description": "ACP エージェントのツール実行権限モード（ask: 都度確認 / allowAll: 自動許可）"
        },
        "kucode.acp.agents": {
          "type": "object",
          "scope": "application",
          "restricted": true,
          "default": {},
          "description": "カスタム ACP エージェント定義マップ（キー: ID, 値: { label, command, args, env, installCommand, loginCommand }）"
        }
      }
    }
  }
}
